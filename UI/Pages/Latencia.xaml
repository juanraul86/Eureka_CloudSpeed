<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Panel izquierdo -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <GroupBox Header="Qué medir">
            <StackPanel>
              <TextBlock Text="Nubes" Style="{StaticResource Muted}" Margin="0,0,0,2"/>
              <WrapPanel x:Name="PanelClouds" Margin="0,0,0,6"/>
              <TextBlock Text="Geografías" Style="{StaticResource Muted}" Margin="0,0,0,2"/>
              <WrapPanel x:Name="PanelGeos" Margin="0,0,0,6"/>
              <TextBlock Text="Buscar región" Style="{StaticResource Muted}" Margin="0,0,0,2"/>
              <TextBox x:Name="TxtSearch" ToolTip="Nombre, código, ciudad o país"/>
              <WrapPanel Margin="0,8,0,0">
                <Button x:Name="BtnSelAll" Content="Marcar todas" Padding="8,3" FontSize="12"/>
                <Button x:Name="BtnSelNone" Content="Desmarcar" Padding="8,3" FontSize="12"/>
              </WrapPanel>
              <TextBlock x:Name="TxtSelCount" Style="{StaticResource Muted}" Text=""/>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Tu conexión">
            <StackPanel>
              <TextBlock x:Name="TxtConn" Style="{StaticResource Muted}" Text="Consulta tu IP pública, ubicación aproximada y operador (servicio ipinfo.io, solo al pulsar)."/>
              <Button x:Name="BtnConn" Content="Ver mi conexión" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,4"/>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Cómo medir">
            <StackPanel>
              <DockPanel>
                <TextBlock x:Name="TxtSamples" DockPanel.Dock="Right" FontWeight="SemiBold" Text="5"/>
                <TextBlock Text="Muestras por región y ronda" Style="{StaticResource Muted}"/>
              </DockPanel>
              <Slider x:Name="SldSamples" Minimum="1" Maximum="20" Value="5" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,4,0,8"/>
              <CheckBox x:Name="ChkTls" Content="Medir también el saludo TLS (HTTPS)"/>
              <CheckBox x:Name="ChkContinuous" Content="Modo continuo (rondas repetidas)"/>
              <DockPanel x:Name="PanelInterval" Margin="22,0,0,0">
                <TextBlock x:Name="TxtInterval" DockPanel.Dock="Right" FontWeight="SemiBold" Text="60 s"/>
                <TextBlock Text="Cada" Style="{StaticResource Muted}"/>
              </DockPanel>
              <Slider x:Name="SldInterval" Minimum="10" Maximum="600" Value="60" IsSnapToTickEnabled="True" TickFrequency="10" Margin="22,4,0,8"/>
              <TextBlock Text="Etiqueta de la medición" Style="{StaticResource Muted}" Margin="0,2,0,2"/>
              <TextBox x:Name="TxtLabel" ToolTip="Por ejemplo: Oficina · fibra, Casa · VPN, 4G. Sirve para comparar en Excel y Power BI."/>
              <CheckBox x:Name="ChkHistory" Content="Guardar en el histórico (para Power BI)" Margin="0,8,12,4"/>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Exportar">
            <StackPanel>
              <Button x:Name="BtnExcel" Content="Excel con gráficos" HorizontalAlignment="Stretch"/>
              <Button x:Name="BtnPowerBI" Content="Power BI (histórico)" HorizontalAlignment="Stretch"/>
              <WrapPanel>
                <Button x:Name="BtnCsv" Content="CSV" Padding="12,5"/>
                <Button x:Name="BtnHtml" Content="Informe HTML" Padding="12,5"/>
              </WrapPanel>
              <CheckBox x:Name="ChkAnon" Content="Ocultar el nombre del equipo" Margin="0,4,0,4"
                        ToolTip="Usa un seudónimo (Equipo-xxxxxxxx) en exportaciones e histórico en lugar del nombre real del equipo."/>
              <TextBlock Style="{StaticResource Muted}" Text="Los archivos se guardan en la carpeta Exportaciones."/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>

      <!-- Zona principal -->
      <DockPanel Grid.Column="2">
        <!-- Acciones + tarjetas -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
            <Button x:Name="BtnStart" Style="{StaticResource PrimaryButton}" Content="▶  Iniciar" Padding="22,9" FontSize="14" Margin="0,0,0,6"/>
            <Button x:Name="BtnQuick" Content="⚡ Prueba rápida (10 rondas)" Padding="10,4" Margin="0,0,0,6" ToolTip="Mide todas las regiones marcadas en 10 rondas seguidas, 1 muestra por ronda"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BtnStop" Style="{StaticResource DangerButton}" Content="Detener" Padding="10,4" Margin="0,0,6,0" IsEnabled="False"/>
              <Button x:Name="BtnReset" Content="Limpiar" Padding="10,4" Margin="0"/>
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock x:Name="CardAzureTitle" Text="Mejor región Azure" Style="{StaticResource Muted}"/>
              <TextBlock x:Name="CardAzure" Text="—" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock x:Name="CardAzureSub" Text=" " Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock x:Name="CardAwsTitle" Text="Mejor región AWS" Style="{StaticResource Muted}"/>
              <TextBlock x:Name="CardAws" Text="—" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock x:Name="CardAwsSub" Text=" " Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="3" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Regiones medidas" Style="{StaticResource Muted}"/>
              <TextBlock x:Name="CardRegions" Text="0" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock x:Name="CardRegionsSub" Text=" " Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="4" Style="{StaticResource Card}" Margin="0">
            <StackPanel>
              <TextBlock Text="Muestras" Style="{StaticResource Muted}"/>
              <TextBlock x:Name="CardSamples" Text="0" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock x:Name="CardSamplesSub" Text=" " Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>
          </Border>
        </Grid>
        <ProgressBar x:Name="Progress" DockPanel.Dock="Top" Margin="0,0,0,8" Maximum="1" Value="0"/>

        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
          <TabControl x:Name="Tabs" BorderThickness="0" Background="Transparent">
            <TabItem Header="Ranking">
              <DataGrid x:Name="Grid">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="" Width="30" MinWidth="30">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasEndpoint}" Margin="0" HorizontalAlignment="Center" ToolTip="Medir esta región"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="36" MinWidth="36" ElementStyle="{StaticResource Num}"/>
                  <DataGridTemplateColumn Header="Nube" Width="74" MinWidth="74">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="8" Height="8" Fill="{Binding CloudColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding Cloud}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Región" Width="1.5*" MinWidth="180">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Tip}">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding Code}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Ubicación" Binding="{Binding City}" Width="*" MinWidth="110"/>
                  <DataGridTemplateColumn Header="P50 (mediana)" Width="160" MinWidth="160">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <Rectangle Width="{Binding BarWidth}" Height="10" RadiusX="3" RadiusY="3" Fill="{Binding LevelColor}" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding P50, StringFormat={}{0:0.0} ms}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="P95" Binding="{Binding P95, StringFormat={}{0:0.0}}" Width="60" MinWidth="60" ElementStyle="{StaticResource Num}"/>
                  <DataGridTextColumn Header="Mín" Binding="{Binding Min, StringFormat={}{0:0.0}}" Width="60" MinWidth="60" ElementStyle="{StaticResource Num}"/>
                                    <DataGridTextColumn Header="Jitter" Binding="{Binding Jitter, StringFormat={}{0:0.0}}" Width="60" MinWidth="60" ElementStyle="{StaticResource Num}"/>
                  <DataGridTextColumn Header="Pérdida" Binding="{Binding Loss, StringFormat={}{0:0.#%}}" Width="66" MinWidth="66" ElementStyle="{StaticResource Num}"/>
                  <DataGridTextColumn x:Name="ColTls" Header="TLS" Binding="{Binding TlsP50, StringFormat={}{0:0.0}}" Width="60" MinWidth="60" ElementStyle="{StaticResource Num}"/>
                  <DataGridTextColumn Header="n" Binding="{Binding Count}" Width="44" MinWidth="44" ElementStyle="{StaticResource Num}"/>
                  <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="96" MinWidth="96"/>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
            <TabItem Header="Gráfico">
              <ScrollViewer x:Name="ScrollBars" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,12">
                <Canvas x:Name="CanvasBars" HorizontalAlignment="Left" VerticalAlignment="Top"/>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Evolución">
              <Grid x:Name="HostLines" Margin="16,12">
                <Canvas x:Name="CanvasLines" HorizontalAlignment="Left" VerticalAlignment="Top"/>
              </Grid>
            </TabItem>
            <TabItem Header="Mapa">
              <Grid x:Name="HostMap" Margin="12">
                <Canvas x:Name="CanvasMap" HorizontalAlignment="Left" VerticalAlignment="Top"/>
              </Grid>
            </TabItem>
            <TabItem Header="Azure vs AWS">
              <Grid x:Name="HostGeo" Margin="16,12">
                <Canvas x:Name="CanvasGeo" HorizontalAlignment="Left" VerticalAlignment="Top"/>
              </Grid>
            </TabItem>
          </TabControl>
        </Border>
      </DockPanel>
    </Grid>
</Grid>

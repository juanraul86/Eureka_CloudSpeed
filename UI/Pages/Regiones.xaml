<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
    <TextBlock Style="{StaticResource PageTitle}" Text="Regiones, zonas y geografías"/>
    <TextBlock Style="{StaticResource Muted}" Text="Nombres e identificadores de región, ubicación del centro de datos, región emparejada, zonas de disponibilidad y residencia de datos. Haz doble clic en una región para verla en el mapa."/>
  </StackPanel>
  <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
    <WrapPanel>
      <StackPanel Width="230" Margin="0,0,14,0"><Label Content="Nube"/>
        <ComboBox x:Name="CmbRegCloud" SelectedIndex="0">
          <ComboBoxItem Content="Azure global" Tag="Global"/><ComboBoxItem Content="Azure China (21Vianet)" Tag="China"/>
          <ComboBoxItem Content="Azure US Government" Tag="USGov"/><ComboBoxItem Content="Azure: regiones previstas" Tag="Prevista"/>
          <ComboBoxItem Content="AWS" Tag="AWS"/>
        </ComboBox></StackPanel>
      <StackPanel Width="200" Margin="0,0,14,0"><Label Content="Grupo"/><ComboBox x:Name="CmbRegGroup"/></StackPanel>
      <StackPanel Width="200" Margin="0,0,14,0"><Label Content="Zonas de disponibilidad"/>
        <ComboBox x:Name="CmbRegZones" SelectedIndex="0"><ComboBoxItem Content="Todas las regiones"/><ComboBoxItem Content="Con zonas"/><ComboBoxItem Content="Sin zonas indicadas"/></ComboBox></StackPanel>
      <StackPanel Width="240" Margin="0,0,14,0"><Label Content="Buscar"/><TextBox x:Name="TxtRegSearch"/></StackPanel>
      <StackPanel Margin="0,0,14,0"><Label Content="Vista"/>
        <StackPanel Orientation="Horizontal" Height="30"><RadioButton x:Name="RbRegList" Content="Lista" GroupName="RegView" IsChecked="True"/><RadioButton x:Name="RbRegGeo" Content="Por geografía" GroupName="RegView"/></StackPanel></StackPanel>
      <Button x:Name="BtnRegCsv" Content="Exportar CSV" VerticalAlignment="Bottom" Margin="0"/>
    </WrapPanel>
  </Border>
  <TextBlock x:Name="TxtRegInfo" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="2,0,0,6"/>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
    <Grid>
      <DataGrid x:Name="GridReg" CanUserSortColumns="True">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Región" Width="1.4*" MinWidth="190" SortMemberPath="Name">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Code}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Ubicación" Binding="{Binding Location}" Width="*" MinWidth="130"/>
          <DataGridTextColumn Header="Geografía" Binding="{Binding Geography}" Width="*" MinWidth="110"/>
          <DataGridTextColumn Header="Grupo" Binding="{Binding Group}" Width="*" MinWidth="120"/>
          <DataGridTextColumn Header="Zonas" Binding="{Binding ZonesText}" Width="60" SortMemberPath="Zones"/>
          <DataGridTextColumn Header="Región emparejada" Binding="{Binding Paired}" Width="*" MinWidth="130"/>
          <DataGridTextColumn Header="Acceso" Binding="{Binding Access}" Width="*" MinWidth="120"/>
          <DataGridTextColumn Header="Residencia de datos" Binding="{Binding Residency}" Width="1.3*" MinWidth="150"/>
          <DataGridTextColumn Header="Latencia" Binding="{Binding LatencyText}" Width="80" SortMemberPath="LatencySort"/>
        </DataGrid.Columns>
      </DataGrid>
      <DataGrid x:Name="GridGeo" CanUserSortColumns="True" Visibility="Collapsed">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Geografía" Binding="{Binding Geography}" Width="180"/>
          <DataGridTextColumn Header="Regiones" Binding="{Binding Count}" Width="80" ElementStyle="{StaticResource Num}"/>
          <DataGridTextColumn Header="Con zonas" Binding="{Binding WithZones}" Width="90" ElementStyle="{StaticResource Num}"/>
          <DataGridTextColumn Header="Regiones de la geografía" Binding="{Binding Regions}" Width="*">
            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </Border>
</DockPanel>

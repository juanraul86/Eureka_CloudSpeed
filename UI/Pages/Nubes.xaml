<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
    <TextBlock Style="{StaticResource PageTitle}" Text="Nubes soberanas y entornos"/>
    <TextBlock Style="{StaticResource Muted}" Text="Azure tiene nubes aisladas con sus propios endpoints para cumplir requisitos legales. Cada una usa dominios distintos para el inicio de sesión, la administración y los servicios."/>
  </StackPanel>
  <UniformGrid x:Name="PanelClouds" DockPanel.Dock="Top" Columns="3" Margin="0,0,0,12"/>
  <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
    <DockPanel>
      <Button x:Name="BtnEnvCsv" DockPanel.Dock="Right" Content="Exportar CSV" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
      <StackPanel Width="300" HorizontalAlignment="Left"><Label Content="Buscar propiedad o endpoint"/><TextBox x:Name="TxtEnvSearch"/></StackPanel>
    </DockPanel>
  </Border>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
    <DataGrid x:Name="GridEnv" CanUserSortColumns="True" RowHeight="NaN" MinRowHeight="28">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Propiedad" Binding="{Binding Property}" Width="1.2*" MinWidth="200"/>
        <DataGridTextColumn Header="AzureCloud (global)" Binding="{Binding Global}" Width="*"/>
        <DataGridTextColumn Header="AzureUSGovernment" Binding="{Binding USGov}" Width="*"/>
        <DataGridTextColumn Header="AzureChinaCloud" Binding="{Binding China}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
  </Border>
</DockPanel>

<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
    <TextBlock Style="{StaticResource PageTitle}" Text="Rangos de IP por servicio y región"/>
    <TextBlock Style="{StaticResource Muted}" Text="Etiquetas de servicio de Azure y rangos publicados por AWS. Elige una etiqueta para ver, copiar o exportar sus prefijos IPv4 e IPv6 (por ejemplo, para reglas de firewall)."/>
  </StackPanel>
  <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
    <WrapPanel>
      <StackPanel Width="220" Margin="0,0,14,0"><Label Content="Nube"/>
        <ComboBox x:Name="CmbRngCloud" SelectedIndex="0">
          <ComboBoxItem Content="Azure Public" Tag="Azure Public"/><ComboBoxItem Content="Azure China" Tag="Azure China"/>
          <ComboBoxItem Content="Azure US Government" Tag="Azure US Gov"/><ComboBoxItem Content="AWS" Tag="AWS"/>
        </ComboBox></StackPanel>
      <StackPanel Width="210" Margin="0,0,14,0"><Label Content="Servicio"/><ComboBox x:Name="CmbRngService"/></StackPanel>
      <StackPanel Width="210" Margin="0,0,14,0"><Label Content="Región"/><ComboBox x:Name="CmbRngRegion"/></StackPanel>
      <StackPanel Width="230" Margin="0,0,14,0"><Label Content="Buscar etiqueta"/><TextBox x:Name="TxtRngSearch"/></StackPanel>
      <StackPanel><Label Content="Tipo"/>
        <StackPanel Orientation="Horizontal" Height="30"><CheckBox x:Name="ChkRngV4" Content="IPv4" IsChecked="True"/><CheckBox x:Name="ChkRngV6" Content="IPv6" IsChecked="True"/></StackPanel></StackPanel>
    </WrapPanel>
  </Border>
  <TextBlock x:Name="TxtRngInfo" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="2,0,0,6"/>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
      <DataGrid x:Name="GridRng" CanUserSortColumns="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Etiqueta" Binding="{Binding Name}" Width="1.6*"/>
          <DataGridTextColumn Header="Servicio" Binding="{Binding Service}" Width="*"/>
          <DataGridTextColumn Header="Región" Binding="{Binding Region}" Width="*"/>
          <DataGridTextColumn Header="IPv4" Binding="{Binding V4}" Width="60" ElementStyle="{StaticResource Num}"/>
          <DataGridTextColumn Header="IPv6" Binding="{Binding V6}" Width="60" ElementStyle="{StaticResource Num}"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12,10">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="BtnRngCopy" Content="Copiar" Padding="10,3" Margin="0,0,6,0"/>
            <Button x:Name="BtnRngSave" Content="Guardar .txt" Padding="10,3" Margin="0"/>
          </StackPanel>
          <TextBlock x:Name="TxtRngSel" Text="Prefijos" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <TextBox x:Name="TxtRngPrefixes" Style="{StaticResource Code}" BorderThickness="0,1,0,0" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" AcceptsReturn="True"/>
      </DockPanel>
    </Border>
  </Grid>
</DockPanel>

<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
    <TextBlock Style="{StaticResource PageTitle}" Text="Latencia entre regiones de Azure"/>
    <TextBlock Style="{StaticResource Muted}" Text="Mediana publicada por Microsoft del tiempo de ida y vuelta (ms) entre regiones a través de su red troncal. Útil para elegir regiones emparejadas, réplicas o arquitecturas activo-activo."/>
  </StackPanel>
  <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
    <WrapPanel VerticalAlignment="Center">
      <StackPanel Margin="0,0,16,0" Width="240"><Label Content="Región de origen"/><ComboBox x:Name="CmbR2RSource"/></StackPanel>
      <StackPanel Margin="0,0,16,0" Width="200"><Label Content="Buscar destino"/><TextBox x:Name="TxtR2RSearch"/></StackPanel>
      <StackPanel Margin="0,0,16,0" Width="170"><Label Content="Latencia máxima"/>
        <ComboBox x:Name="CmbR2RMax" SelectedIndex="0">
          <ComboBoxItem Content="Todas" Tag="0"/><ComboBoxItem Content="Hasta 20 ms" Tag="20"/><ComboBoxItem Content="Hasta 50 ms" Tag="50"/><ComboBoxItem Content="Hasta 100 ms" Tag="100"/><ComboBoxItem Content="Hasta 200 ms" Tag="200"/>
        </ComboBox></StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
        <Button x:Name="BtnR2RCsv" Content="Exportar CSV" Margin="0,0,8,0"/>
        <Button x:Name="BtnR2RExcel" Content="Matriz completa en Excel" Margin="0"/>
      </StackPanel>
    </WrapPanel>
  </Border>
  <TextBlock x:Name="TxtR2RBest" DockPanel.Dock="Top" Margin="2,0,0,8" FontWeight="SemiBold"/>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
      <DataGrid x:Name="GridR2R">
        <DataGrid.Columns>
          <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="40" ElementStyle="{StaticResource Num}"/>
          <DataGridTextColumn Header="Región de destino" Binding="{Binding Destination}" Width="*"/>
          <DataGridTextColumn Header="Ubicación" Binding="{Binding Location}" Width="130"/>
          <DataGridTextColumn Header="RTT" Binding="{Binding Ms, StringFormat={}{0} ms}" Width="70" ElementStyle="{StaticResource Num}"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
      <ScrollViewer x:Name="ScrollR2R" VerticalScrollBarVisibility="Auto" Padding="14,10">
        <Canvas x:Name="CanvasR2R" HorizontalAlignment="Left" VerticalAlignment="Top"/>
      </ScrollViewer>
    </Border>
  </Grid>
</DockPanel>

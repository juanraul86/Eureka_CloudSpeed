<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
    <TextBlock Style="{StaticResource PageTitle}" Text="Precios de máquinas virtuales"/>
    <TextBlock Style="{StaticResource Muted}" Text="Precios públicos en USD, solo cómputo, consultados en vivo: API de precios de Azure y lista de precios de EC2 de AWS. Elige un tamaño para compararlo en todas las regiones."/>
  </StackPanel>
  <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
    <WrapPanel>
      <StackPanel Margin="0,0,14,0"><Label Content="Nube"/>
        <StackPanel Orientation="Horizontal" Height="30"><RadioButton x:Name="RbVmAzure" Content="Azure" GroupName="VmCloud" IsChecked="True"/><RadioButton x:Name="RbVmAws" Content="AWS (EC2)" GroupName="VmCloud"/></StackPanel></StackPanel>
      <StackPanel Width="230" Margin="0,0,14,0"><Label Content="Región"/><ComboBox x:Name="CmbVmRegion"/></StackPanel>
      <StackPanel Margin="0,0,14,0"><Label Content="Sistema"/>
        <StackPanel Orientation="Horizontal" Height="30"><RadioButton x:Name="RbVmLinux" Content="Linux" GroupName="VmOs" IsChecked="True"/><RadioButton x:Name="RbVmWindows" Content="Windows" GroupName="VmOs"/></StackPanel></StackPanel>
      <StackPanel Width="190" Margin="0,0,14,0"><Label Content="Modelo de precio"/><ComboBox x:Name="CmbVmModel"/></StackPanel>
      <StackPanel Margin="0,0,14,0"><Label Content="Mostrar"/>
        <StackPanel Orientation="Horizontal" Height="30"><RadioButton x:Name="RbVmHour" Content="Por hora" GroupName="VmPer" IsChecked="True"/><RadioButton x:Name="RbVmMonth" Content="Por mes (730 h)" GroupName="VmPer"/></StackPanel></StackPanel>
      <Button x:Name="BtnVmLoad" Style="{StaticResource PrimaryButton}" Content="Consultar precios" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
    </WrapPanel>
  </Border>
  <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
    <WrapPanel>
      <StackPanel Width="260" Margin="0,0,14,0"><Label Content="Buscar (tamaño, serie, familia…)"/><TextBox x:Name="TxtVmSearch"/></StackPanel>
      <StackPanel Width="90" Margin="0,0,14,0"><Label Content="vCPU mín."/><TextBox x:Name="TxtVmCpu"/></StackPanel>
      <StackPanel Width="110" Margin="0,0,14,0"><Label Content="Memoria mín. (GB)"/><TextBox x:Name="TxtVmMem"/></StackPanel>
      <StackPanel Width="110" Margin="0,0,14,0"><Label Content="vCPU máx."/><TextBox x:Name="TxtVmCpuMax"/></StackPanel>
      <CheckBox x:Name="ChkVmGpu" Content="Solo con GPU" VerticalAlignment="Bottom" Margin="0,0,14,6"/>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
        <Button x:Name="BtnVmCompare" Content="Comparar en todas las regiones" Margin="0,0,8,0" IsEnabled="False"/>
        <Button x:Name="BtnVmExcel" Content="Exportar a Excel" Margin="0"/>
      </StackPanel>
    </WrapPanel>
  </Border>
  <TextBlock x:Name="TxtVmInfo" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="2,0,0,6" Text="Elige una región y pulsa Consultar precios."/>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
      <DataGrid x:Name="GridVm" CanUserSortColumns="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Tamaño" Binding="{Binding Sku}" Width="1.3*" MinWidth="140"/>
          <DataGridTextColumn Header="Precio (USD)" Binding="{Binding Shown, StringFormat={}{0:N4}}" Width="100" MinWidth="100" ElementStyle="{StaticResource Num}" SortMemberPath="Shown"/>
          <DataGridTextColumn Header="por vCPU" Binding="{Binding PerVcpu, StringFormat={}{0:N4}}" Width="80" MinWidth="80" ElementStyle="{StaticResource Num}"/>
          <DataGridTextColumn Header="vCPU" Binding="{Binding Vcpu}" Width="54" MinWidth="54" ElementStyle="{StaticResource Num}"/>
          <DataGridTextColumn Header="Memoria (GB)" Binding="{Binding MemoryGB}" Width="96" MinWidth="96" ElementStyle="{StaticResource Num}"/>
          <DataGridTextColumn Header="GPU" Binding="{Binding Gpu}" Width="46" MinWidth="46" ElementStyle="{StaticResource Num}"/>
          <DataGridTextColumn Header="Serie / familia" Binding="{Binding Family}" Width="*" MinWidth="110"/>
          <DataGridTextColumn Header="Tipo" Binding="{Binding Category}" Width="*" MinWidth="110"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="12,10">
          <TextBlock Text="Comparar regiones" FontWeight="SemiBold"/>
          <TextBlock x:Name="TxtVmCmp" Style="{StaticResource Muted}" Text="Selecciona un tamaño y pulsa Comparar en todas las regiones."/>
        </StackPanel>
        <DataGrid x:Name="GridVmCmp">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Región" Binding="{Binding Region}" Width="*"/>
            <DataGridTextColumn Header="USD" Binding="{Binding Shown, StringFormat={}{0:N4}}" Width="90" ElementStyle="{StaticResource Num}"/>
            <DataGridTextColumn Header="vs. más barata" Binding="{Binding Delta, StringFormat={}{0:+0%;-0%;0%}}" Width="90" ElementStyle="{StaticResource Num}"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
  </Grid>
</DockPanel>

<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
    <TextBlock Style="{StaticResource PageTitle}" Text="Precios de modelos de IA en Azure"/>
    <TextBlock Style="{StaticResource Muted}" Text="Azure OpenAI y el resto de modelos de Microsoft Foundry, consultados en vivo en la API de precios de Azure. Los precios por token se normalizan a USD por millón de tokens."/>
  </StackPanel>
  <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
    <WrapPanel>
      <StackPanel Width="230" Margin="0,0,14,0"><Label Content="Región de precio"/><ComboBox x:Name="CmbAiRegion"/></StackPanel>
      <Button x:Name="BtnAiLoad" Style="{StaticResource PrimaryButton}" Content="Consultar precios" VerticalAlignment="Bottom" Margin="0,0,24,0"/>
      <StackPanel Width="220" Margin="0,0,14,0"><Label Content="Proveedor / producto"/><ComboBox x:Name="CmbAiProduct"/></StackPanel>
      <StackPanel Width="200" Margin="0,0,14,0"><Label Content="Despliegue"/><ComboBox x:Name="CmbAiDeploy"/></StackPanel>
      <StackPanel Width="240" Margin="0,0,14,0"><Label Content="Buscar modelo"/><TextBox x:Name="TxtAiSearch"/></StackPanel>
      <CheckBox x:Name="ChkAiTokens" Content="Solo precios por token" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,14,6"/>
      <Button x:Name="BtnAiExcel" Content="Exportar a Excel" VerticalAlignment="Bottom" Margin="0"/>
    </WrapPanel>
  </Border>
  <TextBlock x:Name="TxtAiInfo" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="2,0,0,6" Text="Elige una región y pulsa Consultar precios."/>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
    <DataGrid x:Name="GridAi" CanUserSortColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="2*" MinWidth="200"/>
        <DataGridTextColumn Header="Producto" Binding="{Binding Product}" Width="1.3*" MinWidth="140"/>
        <DataGridTextColumn Header="Despliegue" Binding="{Binding Deployment}" Width="110"/>
        <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="140"/>
        <DataGridTextColumn Header="USD / 1M tokens" Binding="{Binding PerMillion, StringFormat={}{0:0.00##}}" Width="120" ElementStyle="{StaticResource Num}"/>
        <DataGridTextColumn Header="Precio" Binding="{Binding Price, StringFormat={}{0:0.######}}" Width="100" ElementStyle="{StaticResource Num}"/>
        <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="90"/>
        <DataGridTextColumn Header="Medidor" Binding="{Binding Meter}" Width="1.5*" MinWidth="160"/>
      </DataGrid.Columns>
    </DataGrid>
  </Border>
</DockPanel>

<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
    <TextBlock Style="{StaticResource PageTitle}" Text="Mapa de regiones"/>
    <TextBlock Style="{StaticResource Muted}" Text="Ubicación aproximada de las regiones de Azure y AWS. Si ya has medido, el color indica la latencia desde este equipo. Pulsa un punto para ver sus datos."/>
  </StackPanel>
  <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
    <WrapPanel>
      <StackPanel Margin="0,0,18,0"><Label Content="Mostrar"/>
        <WrapPanel>
          <CheckBox x:Name="ChkMapAzure" Content="Azure" IsChecked="True"/>
          <CheckBox x:Name="ChkMapAws" Content="AWS" IsChecked="True"/>
          <CheckBox x:Name="ChkMapSov" Content="China y US Gov"/>
          <CheckBox x:Name="ChkMapPlanned" Content="Previstas"/>
          <CheckBox x:Name="ChkMapLabels" Content="Nombres"/>
        </WrapPanel></StackPanel>
      <StackPanel Margin="0,0,18,0"><Label Content="Color"/>
        <StackPanel Orientation="Horizontal"><RadioButton x:Name="RbMapCloud" Content="Por nube" GroupName="MapColor" IsChecked="True"/><RadioButton x:Name="RbMapLat" Content="Por latencia medida" GroupName="MapColor"/></StackPanel></StackPanel>
      <StackPanel Width="190" Margin="0,0,14,0"><Label Content="Zona del mapa"/>
        <ComboBox x:Name="CmbMapZoom" SelectedIndex="0">
          <ComboBoxItem Content="Mundo" Tag="-170,190,-58,78"/><ComboBoxItem Content="Europa" Tag="-25,45,33,68"/>
          <ComboBoxItem Content="Norteamérica" Tag="-130,-60,12,58"/><ComboBoxItem Content="Sudamérica" Tag="-90,-30,-45,15"/>
          <ComboBoxItem Content="Asia-Pacífico" Tag="65,180,-48,48"/><ComboBoxItem Content="Oriente Medio y África" Tag="-20,65,-38,42"/>
        </ComboBox></StackPanel>
      <StackPanel Width="220"><Label Content="Buscar región"/><TextBox x:Name="TxtMapSearch"/></StackPanel>
    </WrapPanel>
  </Border>
  <Border DockPanel.Dock="Right" Width="300" Margin="12,0,0,0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="14,12">
    <StackPanel>
      <TextBlock Text="Región seleccionada" Style="{StaticResource Muted}"/>
      <TextBlock x:Name="TxtMapName" Text="Ninguna" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="TxtMapDetails" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20"/>
      <Button x:Name="BtnMapMeasure" Style="{StaticResource PrimaryButton}" Content="Medir latencia" HorizontalAlignment="Left" Margin="0,12,0,0" IsEnabled="False"/>
      <TextBlock x:Name="TxtMapLegend" Style="{StaticResource Muted}" Margin="0,18,0,0" TextWrapping="Wrap"/>
    </StackPanel>
  </Border>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
    <Grid x:Name="HostWorld" Margin="6">
      <Canvas x:Name="CanvasWorld" HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </Grid>
  </Border>
</DockPanel>

<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
    <TextBlock Style="{StaticResource PageTitle}" Text="Estado de servicios"/>
    <TextBlock Style="{StaticResource Muted}" Text="Lo que publican Microsoft, AWS, Google, GitHub y Cloudflare, comparado con lo que se ve desde tu red. En una caída global la página de estado oficial puede tardar en informar o caer también: por eso se comprueba además que cada servicio responde."/>
  </StackPanel>

  <Border x:Name="BrdStBanner" DockPanel.Dock="Top" CornerRadius="6" Padding="16,12" Margin="0,0,0,10" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
    <DockPanel>
      <Ellipse x:Name="DotStBanner" Width="14" Height="14" Fill="#9CA3AF" Margin="0,0,12,0" VerticalAlignment="Top" DockPanel.Dock="Left"/>
      <StackPanel>
        <TextBlock x:Name="TxtStBanner" Text="Pulsa Comprobar ahora" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="TxtStBannerSub" Style="{StaticResource Muted}" Text=" "/>
      </StackPanel>
    </DockPanel>
  </Border>

  <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
    <WrapPanel VerticalAlignment="Center">
      <Button x:Name="BtnStRefresh" Style="{StaticResource PrimaryButton}" Content="↻  Comprobar ahora" Margin="0,0,12,0"/>
      <CheckBox x:Name="ChkStAuto" Content="Comprobar cada" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <ComboBox x:Name="CmbStEvery" Width="110" SelectedIndex="1" Margin="0,0,16,0">
        <ComboBoxItem Content="1 minuto" Tag="60"/><ComboBoxItem Content="2 minutos" Tag="120"/>
        <ComboBoxItem Content="5 minutos" Tag="300"/><ComboBoxItem Content="15 minutos" Tag="900"/>
      </ComboBox>
      <CheckBox x:Name="ChkStHistory" Content="Guardar histórico (evidencias para SLA)" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
      <Button x:Name="BtnStCsv" Content="Exportar CSV" Margin="0,0,8,0"/>
      <Button x:Name="BtnStOpen" Content="Abrir página de estado" IsEnabled="False" Margin="0"/>
      <TextBlock x:Name="TxtStNext" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/>
    </WrapPanel>
  </Border>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Estado oficial publicado por cada proveedor" FontWeight="SemiBold" Margin="12,8"/>
        <DataGrid x:Name="GridStOfficial" CanUserSortColumns="True" RowHeight="NaN" MinRowHeight="28">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Estado" Width="130" MinWidth="130" SortMemberPath="Level">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{Binding LevelColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding State}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Proveedor" Binding="{Binding Provider}" Width="130" MinWidth="130"/>
            <DataGridTextColumn Header="Servicio" Binding="{Binding Service}" Width="200" MinWidth="170"/>
            <DataGridTextColumn Header="Detalle" Binding="{Binding Detail}" Width="*" MinWidth="200">
              <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4"/></Style></DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Actualizado" Binding="{Binding Updated}" Width="120" MinWidth="120"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
    <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Comprobación desde tu red (DNS, conexión y HTTPS)" FontWeight="SemiBold" Margin="12,8"/>
        <DataGrid x:Name="GridStProbe" CanUserSortColumns="True">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Estado" Width="130" MinWidth="130" SortMemberPath="Level">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{Binding LevelColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding State}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Proveedor" Binding="{Binding Provider}" Width="130" MinWidth="130"/>
            <DataGridTextColumn Header="Servicio" Binding="{Binding Service}" Width="1.2*" MinWidth="170"/>
            <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="*" MinWidth="150"/>
            <DataGridTextColumn Header="DNS" Binding="{Binding DnsMs, StringFormat={}{0:0} ms}" Width="64" MinWidth="64" ElementStyle="{StaticResource Num}"/>
            <DataGridTextColumn Header="Conexión" Binding="{Binding ConnectMs, StringFormat={}{0:0} ms}" Width="80" MinWidth="80" ElementStyle="{StaticResource Num}"/>
            <DataGridTextColumn Header="HTTPS" Binding="{Binding HttpMs, StringFormat={}{0:0} ms}" Width="72" MinWidth="72" ElementStyle="{StaticResource Num}"/>
            <DataGridTextColumn Header="Detalle" Binding="{Binding Detail}" Width="*" MinWidth="140"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
  </Grid>
</DockPanel>

<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
    <TextBlock Style="{StaticResource PageTitle}" Text="Búsqueda de IP"/>
    <TextBlock Style="{StaticResource Muted}" Text="Averigua si una IP, un dominio o una URL pertenecen a Azure (Public, China o US Government) o a AWS, y a qué servicio y región. Útil para revisar reglas de firewall, registros de tráfico y alertas de seguridad."/>
  </StackPanel>
  <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
    <StackPanel>
      <DockPanel>
        <Button x:Name="BtnIpLookup" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Buscar" Margin="8,0,0,0" Padding="18,6"/>
        <TextBox x:Name="TxtIpQuery" FontSize="14" ToolTip="IPv4, IPv6, dominio o URL (se usa solo el nombre del servidor)"/>
      </DockPanel>
      <WrapPanel Margin="0,8,0,0">
        <TextBlock Text="Ejemplos:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Button x:Name="BtnIpEx1" Content="portal.azure.com" Padding="8,2" FontSize="12"/>
        <Button x:Name="BtnIpEx2" Content="westeurope.api.cognitive.microsoft.com" Padding="8,2" FontSize="12"/>
        <Button x:Name="BtnIpEx3" Content="s3.eu-south-2.amazonaws.com" Padding="8,2" FontSize="12"/>
        <Button x:Name="BtnIpEx4" Content="20.61.99.32" Padding="8,2" FontSize="12"/>
      </WrapPanel>
      <WrapPanel Margin="0,4,0,0">
        <CheckBox x:Name="ChkIpPublic" Content="Azure Public" IsChecked="True"/>
        <CheckBox x:Name="ChkIpChina" Content="Azure China" IsChecked="True"/>
        <CheckBox x:Name="ChkIpGov" Content="Azure US Government" IsChecked="True"/>
        <CheckBox x:Name="ChkIpAws" Content="AWS" IsChecked="True"/>
      </WrapPanel>
    </StackPanel>
  </Border>
  <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
    <DockPanel>
      <Button x:Name="BtnIpUpdate" DockPanel.Dock="Right" Content="Descargar / actualizar datos" Margin="8,0,0,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="TxtIpData" Style="{StaticResource Muted}" VerticalAlignment="Center" Text="Datos de rangos: comprobando…"/>
    </DockPanel>
  </Border>
  <TextBlock x:Name="TxtIpInfo" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="2,0,0,8"/>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
    <DataGrid x:Name="GridIp" CanUserSortColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="150"/>
        <DataGridTextColumn Header="Nube" Binding="{Binding Cloud}" Width="130"/>
        <DataGridTextColumn Header="Etiqueta de servicio" Binding="{Binding Name}" Width="1.4*"/>
        <DataGridTextColumn Header="Servicio" Binding="{Binding Service}" Width="*"/>
        <DataGridTextColumn Header="Región" Binding="{Binding Region}" Width="*"/>
        <DataGridTextColumn Header="Prefijo" Binding="{Binding Prefix}" Width="170"/>
      </DataGrid.Columns>
    </DataGrid>
  </Border>
</DockPanel>

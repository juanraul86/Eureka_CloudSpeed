<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eureka_CloudSpeed" Width="1440" Height="900" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}">
  <!-- Los estilos y la paleta están en Theme.xaml (recursos de la aplicación). Cada sección es una
       página en UI\Pages que se carga la primera vez que se abre. -->
  <DockPanel Background="{DynamicResource Bg}">
    <Border DockPanel.Dock="Top" Background="{DynamicResource Header}" Padding="20,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnFolder" Style="{StaticResource HeaderButton}" Content="Abrir carpeta de datos"/>
          <Button x:Name="BtnTheme" Style="{StaticResource HeaderButton}" Content="Tema: sistema"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Eureka_CloudSpeed" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock x:Name="TxtSubtitle" Text="Latencia, velocidad, precios e información de Azure y AWS desde este equipo" Foreground="{DynamicResource HeaderSub}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,6">
      <DockPanel>
        <TextBlock x:Name="TxtVersion" DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="v1.0"/>
        <TextBlock x:Name="TxtStatus" Style="{StaticResource Muted}" Text="Listo."/>
      </DockPanel>
    </Border>

    <!-- Menú lateral -->
    <Border DockPanel.Dock="Left" Width="218" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="NavPanel" Margin="0,4,0,12">
          <TextBlock Style="{StaticResource NavHeader}" Text="ESTADO"/>
          <RadioButton x:Name="NavEstado" Style="{StaticResource NavItem}" Tag="Estado" Content="Estado de servicios"/>
          <TextBlock Style="{StaticResource NavHeader}" Text="MEDIR"/>
          <RadioButton x:Name="NavLatencia" Style="{StaticResource NavItem}" Tag="Latencia" Content="Latencia" IsChecked="True"/>
          <RadioButton x:Name="NavVelocidad" Style="{StaticResource NavItem}" Tag="Velocidad" Content="Velocidad (descarga y subida)"/>
          <RadioButton x:Name="NavRegionRegion" Style="{StaticResource NavItem}" Tag="RegionRegion" Content="Latencia entre regiones"/>
          <RadioButton x:Name="NavComandos" Style="{StaticResource NavItem}" Tag="Comandos" Content="Comandos (PsPing y otros)"/>
          <TextBlock Style="{StaticResource NavHeader}" Text="PRECIOS"/>
          <RadioButton x:Name="NavPreciosVm" Style="{StaticResource NavItem}" Tag="PreciosVm" Content="Máquinas virtuales"/>
          <RadioButton x:Name="NavPreciosIa" Style="{StaticResource NavItem}" Tag="PreciosIa" Content="Modelos de IA"/>
          <TextBlock Style="{StaticResource NavHeader}" Text="INFORMACIÓN"/>
          <RadioButton x:Name="NavRegiones" Style="{StaticResource NavItem}" Tag="Regiones" Content="Regiones y zonas"/>
          <RadioButton x:Name="NavMapa" Style="{StaticResource NavItem}" Tag="Mapa" Content="Mapa de regiones"/>
          <RadioButton x:Name="NavNubes" Style="{StaticResource NavItem}" Tag="Nubes" Content="Nubes soberanas y entornos"/>
          <TextBlock Style="{StaticResource NavHeader}" Text="RED"/>
          <RadioButton x:Name="NavIp" Style="{StaticResource NavItem}" Tag="Ip" Content="Búsqueda de IP"/>
          <RadioButton x:Name="NavRangos" Style="{StaticResource NavItem}" Tag="Rangos" Content="Rangos de IP"/>
          <TextBlock Style="{StaticResource NavHeader}" Text="AYUDA"/>
          <RadioButton x:Name="NavAyuda" Style="{StaticResource NavItem}" Tag="Ayuda" Content="Ayuda y preguntas"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Contenido: aquí se insertan las páginas -->
    <Grid x:Name="PageHost" Margin="16,14,16,12"/>
  </DockPanel>
</Window>
